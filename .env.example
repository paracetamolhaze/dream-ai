# ════════════════════════════════════════════════════════════════════════════
#  DREAM AI — environment configuration
#  Copy to `.env` and fill in. Variables marked (required) must be set for
#  APP_ENV=production; the services refuse to start without them.
# ════════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production                       # development | staging | production
APP_NAME=DREAM AI                        # brand name shown in bot messages (UI brand: apps/web/src/lib/brand.ts)
APP_DOMAIN=dream.example.com             # (required) domain served by Caddy with automatic HTTPS
HTTP_PORT=80                             # host ports published by Caddy (80/443 required for Let's Encrypt)
HTTPS_PORT=443
PUBLIC_APP_URL=https://dream.example.com # (required) public HTTPS origin of the Mini App
PUBLIC_API_URL=                          # optional: backend origin when the Mini App UI is hosted elsewhere (e.g. Vercel);
                                         # API, media, admin, share pages and the bot webhook live here
CORS_ORIGINS=                            # optional: extra browser origins allowed to call the API (PUBLIC_APP_URL is always allowed)
# VERCEL_TOKEN=                          # only for scripts/deploy-miniapp-vercel.mjs (keep it in .env, never commit)

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                      # (required) from @BotFather
TELEGRAM_BOT_USERNAME=                   # (required) bot username without @
TELEGRAM_MINIAPP_SHORT_NAME=             # optional: short name of a named Mini App (t.me/<bot>/<name>); empty = Main Mini App
BOT_MODE=webhook                         # webhook (production) | polling (local development)
TELEGRAM_WEBHOOK_SECRET=                 # (required for webhook) random string, e.g. `openssl rand -hex 32`
TELEGRAM_WEBHOOK_PATH=/telegram/webhook  # must start with /telegram/ (routed by Caddy to the bot)
TELEGRAM_CHANNEL_ID=                     # optional: @channel or -100… id for channel publishing (bot must be admin)
TELEGRAM_CHANNEL_URL=                    # optional: https://t.me/yourchannel (shown in the app)
SUPPORT_CHAT_ID=                         # optional: chat id where support tickets are forwarded
INIT_DATA_MAX_AGE_SEC=86400              # Mini App initData lifetime

# ── Admin & security ────────────────────────────────────────────────────────
ADMIN_TELEGRAM_IDS=                      # comma-separated Telegram user ids with admin access (send /admin to the bot)
ADMIN_SESSION_SECRET=                    # (required) random 32+ chars — signs admin session cookies
MEDIA_SIGNING_SECRET=                    # (required) random 32+ chars — signs private media URLs
ALLOW_DEV_AUTH=false                     # development only: open the Mini App in a normal browser (refused in production)
ADMIN_TIMEZONE=Europe/Moscow             # timezone used to display dates in the admin panel

# ── AI providers (set the ones you use; select models in Admin → Models) ────
DEMO_MODE=false                          # true = providers without keys fall back to clearly labelled DEMO output
OPENAI_API_KEY=                          # speech-to-text (gpt-transcribe, default), OpenAI-compatible LLM/images
OPENAI_BASE_URL=https://api.openai.com/v1
STT_API_KEY=                             # optional override for STT (defaults to OPENAI_API_KEY), e.g. a Groq key
STT_BASE_URL=                            # optional: https://api.groq.com/openai/v1 (cheapest) or a local faster-whisper-server
LLM_OPENAI_API_KEY=                      # optional override for an OpenAI-compatible LLM (OpenRouter etc.)
LLM_OPENAI_BASE_URL=
ANTHROPIC_API_KEY=                       # Claude — default dream analysis model
FAL_KEY=                                 # fal.ai — default images (Meta Muse, FLUX.3 klein fallback) and video (HeyGen)
REPLICATE_API_TOKEN=                     # Replicate — alternative images/video
RUNWAY_API_KEY=                          # Runway — alternative video
IMAGE_OPENAI_API_KEY=                    # optional override for OpenAI-compatible images (gpt-image-1, LocalAI)
IMAGE_OPENAI_BASE_URL=

# ── Limits ──────────────────────────────────────────────────────────────────
MAX_AUDIO_SECONDS=600
MAX_AUDIO_BYTES=26214400
MAX_DREAM_TEXT_CHARS=8000

# ── Infrastructure (defaults match compose.yaml; override for managed services) ─
POSTGRES_USER=dream
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dream
S3_ENDPOINT=http://minio:9000            # leave as is for bundled MinIO; set to your S3 endpoint otherwise (empty = AWS)
S3_REGION=us-east-1
S3_BUCKET=dream-media
S3_ACCESS_KEY_ID=dreamminio              # also the MinIO root user
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
MEDIA_DELIVERY=proxy                     # proxy (stream through the app) | redirect (presigned S3 URLs, needs public S3 endpoint)
# MINIO_IMAGE=bitnamilegacy/minio:2025.7.23

LOG_LEVEL=info
