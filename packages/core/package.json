{
  "name": "@dream/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/lib-storage": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "grammy": "1.46.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
